{
  "name": "ringwatch-opus",
  "private": true,
  "description": "圣火守护者 Flame Guardian · 奇幻守村割草塔防（Steam 桌面版）",
  "version": "0.4.0",
  "main": "desktop/main.js",
  "productName": "FlameGuardian",
  "scripts": {
    "dev": "node tools/lib/serve.js 8080",
    "check": "node tools/check.js",
    "test:sim": "node tools/simtest.js",
    "balance": "node tools/balance.js",
    "voice": "node tools/steam-voice.js",
    "test:flow": "node tools/flowtest.js shots/flow",
    "test:cam": "node tools/camtest.js",
    "audit:game": "node tools/audit.js",
    "audit:ui": "node tools/uiaudit.js shots/audit",
    "test:play": "node tools/playtest.js shots/play 2",
    "shots": "node tools/shots.js shots/art",
    "test": "npm run check && npm run test:flow",
    "music": "node tools/music-preview.js shots/music 20",
    "vendor:three": "node tools/vendor-three.js",
    "desktop": "electron .",
    "desktop:smoke": "electron . --smoke --no-sandbox",
    "dist": "electron-builder --dir",
    "dist:win": "electron-builder --win --dir",
    "dist:linux": "electron-builder --linux --dir",
    "dist:mac": "electron-builder --mac --dir",
    "sync": "node tools/sync-status.js"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "1.56.1",
    "three": "0.186.1"
  },
  "engines": {
    "node": ">=18"
  },
  "build": {
    "appId": "com.flameguardian.game",
    "productName": "FlameGuardian",
    "copyright": "Copyright © 2026 Flame Guardian",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "preview.html",
      "js/**",
      "vendor/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "dir"
    },
    "linux": {
      "target": "dir",
      "category": "Game"
    },
    "mac": {
      "target": "dir",
      "category": "public.app-category.action-games"
    },
    "executableName": "FlameGuardian"
  }
}
